	partition DimCalendar = calculated
		mode: import
		source =
				ADDCOLUMNS(CALENDARAUTO(),
				                    "#Year",YEAR([Date]),
				                    "#Quarter",QUARTER([Date]),
				                    "#Month",MONTH([Date]),
				                    "#Day",Day([Date]),
				                    "#WeekDay",WEEKDAY([Date]),"Day",FORMAT(WEEKDAY([Date]),"DDD"),
				                    "WeekNum",WEEKNUM([Date]))

	annotation PBI_Id = 0e47fd59f53c45fe9cecaa0acd7caba6

