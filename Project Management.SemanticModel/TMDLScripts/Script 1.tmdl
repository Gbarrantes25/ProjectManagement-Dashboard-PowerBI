createOrReplace

	ref table Measure

		measure #AC = SUM(Fact_Task[ac])
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: Calculations
			lineageTag: f14b4026-4bc8-4071-8106-f308ea5010c0

		measure #AC_YTD = ```
				
					VAR _DateMax = EOMONTH(
						TODAY(),
						0
					)
					VAR _Result = IF(
						MAX(DimCalendar[Date]) <= _DateMax,
						TOTALYTD(
							[#AC],
							DimCalendar[Date],
							DimCalendar[Date] <= _DateMax
						),
						BLANK()
					)
					RETURN
						_Result
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: YTD
			lineageTag: cf86d332-dffc-47aa-a212-f15bf856d8ca

			annotation PBI_FormatHint = {"currencyCulture":"es-US"}

		measure #BU =
				
				VAR _Result = SUMX(VALUES(Fact_Task[task_id]),CALCULATE(MAX(Fact_Task[budget])))
				RETURN _Result
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: Calculations
			lineageTag: 0271d258-df4c-4b40-b9b7-b263cda2ce51

		measure #BU_YTD = ```
				
					VAR _DateMax = EOMONTH(
						TODAY(),
						0
					)
					VAR _Result =
					IF(
						MAX(DimCalendar[Date]) <= _DateMax,
						TOTALYTD(
							[#BU],
							DimCalendar[Date],
							DimCalendar[Date] <= _DateMax
						),
						BLANK()
					)
				
					RETURN
						_Result
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: YTD
			lineageTag: 506415c0-21c9-4f78-983d-f8bb3d149717

		measure #CountTask = DISTINCTCOUNT(Fact_Task[task_id])
			formatString: 0
			displayFolder: Basics
			lineageTag: 991b3477-c6fe-4374-866b-63eb4ba9b495

		measure #CPI = ```
				
				VAR _CPI = 
				    IF(
				        ISBLANK([#AC]) || [#AC] = 0, 
				        BLANK(), 
				        DIVIDE([#EV], [#AC], BLANK())
				    )
				VAR _Result = IF(NOT(ISBLANK(_CPI)), MIN(_CPI, 3.00), BLANK())
				RETURN _Result
				    
				```
			displayFolder: KPI
			lineageTag: a39057ba-f783-4d4e-bb94-d6afef7a3363

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure #CV = [#EV]-[#AC]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: Calculations
			lineageTag: 6188aba5-e506-4e00-896e-b7210996ffa6

		measure #EAC =
				
				IF(
				    ISBLANK([#CPI]) || [#CPI] = 0,
				    [#BU],
				    DIVIDE([#BU], [#CPI])
				)
			displayFolder: Calculations
			lineageTag: 984762cb-b252-4540-8103-179db8ce945f

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure #EV = [#BU]*[#Progress(%)]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: Calculations
			lineageTag: cecb5098-db0c-4dde-a03e-0c858f39b3a3

		measure #EV_YTD = ```
				
				VAR _Todaydate = EOMONTH(TODAY(),0)
				VAR _Result = IF(MAX(DimCalendar[Date]) <= _Todaydate,[#EV],BLANK())
				RETURN _Result
				    
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: YTD
			lineageTag: 36628831-8461-44ea-aaae-5849de22d767

		measure #Executed_Budget = DIVIDE([#AC],[#BU],0)
			formatString: 0.00\ %;-0.00\ %;0.00\ %
			displayFolder: Calculations
			lineageTag: 910bbfde-025e-4270-8b2f-b2c340748f3b

		measure #Progress(%) =
				
				VAR _RealProgress = SUMX(VALUES(Fact_Task[task_id]),CALCULATE(MAX(Fact_Task[phase_weight])*CALCULATE(MAX(Fact_Task[progress_acc]))))
				VAR _TotalProgress = SUMX(VALUES(Fact_Task[task_id]),CALCULATE(MAX(Fact_Task[phase_weight])))
				
				RETURN DIVIDE(_RealProgress,_TotalProgress,0)
			formatString: 0.00\ %;-0.00\ %;0.00\ %
			displayFolder: Calculations
			lineageTag: 3c3094b2-b652-4ae1-958c-406a2b8a6d57

		measure #ProjectsQuantity = DISTINCTCOUNT(Fact_Task[project_id])
			formatString: 0
			displayFolder: Basics
			lineageTag: 0cff308f-fc5c-4459-9f9d-47020476921f

		measure #PV =
				
				VAR _MaxContextDate = TODAY()
				VAR _TotalDays = DATEDIFF(CALCULATE(MIN(Fact_Task[planned_startdate])),CALCULATE(MAX(Fact_Task[planned_enddate])),DAY)+1
				VAR _RealEnd = IF([#Progress(%)]=1,CALCULATE(MAX(Fact_Task[real_enddate])),BLANK())
				VAR _StatementDate = IF(ISBLANK(_RealEnd),_MaxContextDate,_RealEnd)
				VAR _ElapsedDays = MAX(0,DATEDIFF(CALCULATE(MIN(Fact_Task[planned_startdate])),_StatementDate,DAY)+1)
				VAR _ProgressPct = MIN(1,DIVIDE(_ElapsedDays,_TotalDays,0))
				RETURN _ProgressPct*[#BU]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: Calculations
			lineageTag: de53b36c-b469-42f6-9a14-b7ac9a2fa76c

		measure #PV_YTD = ```
				
				VAR _Todaydate = EOMONTH(TODAY(),0)
				VAR _Result = IF(MAX(DimCalendar[Date]) <= _Todaydate,[#PV],BLANK())
				RETURN _Result
				    
				```
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: YTD
			lineageTag: 671c8a2c-0248-4f31-8bea-8a0b81063661

		measure #SPI = ```
				
				VAR _PlannedEnd = MAX(Fact_Task[planned_enddate])
				VAR _Result = IF([Status] = "To Do" && [#EV] = 0 && _PlannedEnd>TODAY(), 
				                BLANK(), 
				                DIVIDE([#EV], [#PV],BLANK())
				            )
				RETURN _Result
				```
			displayFolder: KPI
			lineageTag: 5fa97680-805e-41e3-bfa8-4e5bf643c278

			annotation PBI_FormatHint = {"isGeneralNumber":true}

		measure #VAC = [#BU]-[#EAC]
			formatString: \$#,0.00;(\$#,0.00);\$#,0.00
			displayFolder: Calculations
			lineageTag: 9190183d-f603-4d7e-9a90-3db8109a7a00

		measure CardOverview = ```
				
				VAR _VirtualProjectsTable = 
				    CALCULATETABLE(
				        ADDCOLUMNS(
				            SUMMARIZE(DimProjects, DimProjects[project_id]),
				            "@Status", [Status],
				            "@StatusAlert", [Status_Alert]
				        ),
				        ALLSELECTED()
				    )
				
				VAR _Budget_Format = 
				    SWITCH(TRUE(),
				        [#BU] >= 1000000, FORMAT([#BU] / 1000000, "$0.0") & "M",
				        [#BU] >= 1000, FORMAT([#BU] / 1000, "$0.0") & "K",
				        FORMAT([#BU], "$#,##0")
				    )
				VAR _AC_Format = 
				    SWITCH(TRUE(),
				        [#AC] >= 1000000, FORMAT([#AC] / 1000000, "$0.0") & "M",
				        [#AC] >= 1000, FORMAT([#AC] / 1000, "$0.0") & "K",
				        FORMAT([#AC], "$#,##0")
				    )
				VAR _CV_Format = 
				    SWITCH(TRUE(),
				        [#CV] >= 1000000, FORMAT([#CV] / 1000000, "$0.0") & "M",
				        [#CV] >= 1000, FORMAT([#CV] / 1000, "$0.0") & "K",
				        FORMAT([#CV], "$#,##0")
				    )
				VAR _CPI_Format = 
				    SWITCH(TRUE(),
				        [#CPI] >= 1000000, FORMAT([#CPI] / 1000000, "0.00") & "M",
				        [#CPI] >= 1000, FORMAT([#CPI] / 1000, "0.00") & "K",
				        FORMAT(ROUND([#CPI],2),"#0.00","En-US")
				    )
				VAR _SPI_Format = 
				    SWITCH(TRUE(),
				        [#SPI] >= 1000000, FORMAT([#SPI] / 1000000, "0.00") & "M",
				        [#SPI] >= 1000, FORMAT([#SPI] / 1000, "0.00") & "K",
				        FORMAT([#SPI], "#0.00","En-US")
				    )
				VAR _EAC_Format = 
				    SWITCH(TRUE(),
				        [#EAC] >= 1000000, FORMAT([#EAC] / 1000000, "$0.0") & "M",
				        [#EAC] >= 1000, FORMAT([#EAC] / 1000, "$0.0") & "K",
				        FORMAT([#EAC], "$#,##0")
				    )
				
				VAR _VAC_Format = 
				    SWITCH(TRUE(),
				        [#VAC] >= 1000000, FORMAT([#VAC] / 1000000, "$0.0") & "M",
				        [#VAC] >= 1000, FORMAT([#VAC] / 1000, "$0.0") & "K",
				        FORMAT([#VAC], "$#,##0")
				    )
				
				VAR _CountDone = COUNTROWS(FILTER(
				                            _VirtualProjectsTable,
				                            [@Status] = "Done"
				                        ))
				
				VAR _CountInProgress = COUNTROWS(FILTER(
				                            _VirtualProjectsTable,
				                            [@Status] = "In Progress"
				                        ))
				
				VAR _CountToDo = COUNTROWS(FILTER(
				                            _VirtualProjectsTable,
				                            [@Status] = "To Do"
				                        ))
				
				VAR _CountAtRisk = COUNTROWS(FILTER(
				                            _VirtualProjectsTable,
				                            [@StatusAlert] = "Critical" || [@StatusAlert] = "At Risk"
				                        ))
				
				RETURN
				"
				<html lang='es'>
				<style>
				:root{
				    --bg:#f4f7fb;
				    --card-radius:18px;
				    --shadow:0 10px 25px rgba(0,0,0,.10);
				    --text:#ffffff;
				}
				
				*{
				    margin:0;
				    padding:0;
				    box-sizing:border-box;
				    font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
				}
				
				body{
				    background:var(--bg);
				    padding:30px;
				}
				
				.kpi-grid{
				    display:grid;
				    grid-template-columns:repeat(auto-fit,minmax(165px,1fr));
				    gap:8px;
				}
				
				.kpi-card{
				    position:relative;
				    overflow:hidden;
				    border-radius:var(--card-radius);
				    padding:30px;
				    color:var(--text);
				    box-shadow:var(--shadow);
				    transition:.3s ease;
				}
				
				.kpi-card:hover{
				    transform:translateY(-4px);
				}
				
				.kpi-card::before{
				    content:'';
				    position:absolute;
				    top:-40px;
				    right:-40px;
				    width:110px;
				    height:110px;
				    border-radius:50%;
				    background:rgba(255,255,255,.12);
				}
				
				.kpi-header{
				    display:flex;
				    justify-content:space-between;
				    align-items:center;
				    margin-bottom:10px;
				}
				
				.kpi-title{
				    font-size:.75rem;
				    font-weight:700;
				    opacity:.95;
				}
				
				.kpi-icon{
				    width:40px;
				    height:40px;
				    border-radius:12px;
				    background:rgba(255,255,255,.18);
				    display:flex;
				    align-items:center;
				    justify-content:center;
				    font-size:18px;
				    backdrop-filter:blur(5px);
				}
				
				.kpi-value{
				    font-size:1.2rem;
				    font-weight:700;
				    line-height:1;
				}
				
				.kpi-footer{
				    margin-top:10px;
				    font-size:.85rem;
				    opacity:.9;
				}
				
				/* Gradientes individuales */
				.projects{
				    background:linear-gradient(135deg,#4D70FF,#40ADF6);
				}
				
				.ToDo{
				    background:linear-gradient(135deg,#757DFC,#CB7AFE);
				}
				
				.InProgress{
				    background:linear-gradient(135deg,#E8697D,#EC9B65);
				}
				
				.Done{
				    background:linear-gradient(135deg,#28a37d,#43D79D);
				}
				
				.AtRisk{
				    background:linear-gradient(135deg,#d7327d,#E8697D);
				}
				
				
				.Budget, .Ac, .CV, .EAC, .VAC, .CPI, .SPI{
				    background:linear-gradient(135deg,#4E6483,#99AAC2);
				}
				
				
				</style>
				<body>
				
				<div class='kpi-grid'>
				
				    <!-- Total Proyectos -->
				    <div class='kpi-card projects'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>Total Projects</div>
				            <div class='kpi-icon'>📁</div>
				        </div>
				        <div class='kpi-value'>"&[#ProjectsQuantity]&"</div>
				    </div>
				
				    <!-- Status To Do -->
				    <div class='kpi-card ToDo'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>To-Do</div>
				            <div class='kpi-icon'>⏳</div>
				        </div>
				        <div class='kpi-value'>"&_CountToDo&"</div>
				    </div>
				
				    <!-- Status In Progress -->
				    <div class='kpi-card InProgress'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>In Progress</div>
				            <div class='kpi-icon'>📌</div>
				        </div>
				        <div class='kpi-value'>"&_CountInProgress&"</div>
				    </div>
				
				    <!-- Status Done -->
				    <div class='kpi-card Done'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>Done</div>
				            <div class='kpi-icon'>✅</div>
				        </div>
				        <div class='kpi-value'>"&_CountDone&"</div>
				    </div>
				
				    <!-- Status Alert At Risk -->
				    <div class='kpi-card AtRisk'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>At Risk</div>
				            <div class='kpi-icon'>🚨</div>
				        </div>
				        <div class='kpi-value'>"&_CountAtRisk&"</div>
				    </div>
				
				    <!-- Budget -->
				    <div class='kpi-card Budget'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>Total Budget</div>
				            <div class='kpi-icon'>💰</div>
				        </div>
				        <div class='kpi-value'>"&_Budget_Format&"</div>
				    </div>
				
				    <!-- AC -->
				    <div class='kpi-card Ac'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>Total AC</div>
				            <div class='kpi-icon'>💵</div>
				        </div>
				        <div class='kpi-value'>"&_AC_Format&"</div>
				    </div>
				
				    <!-- CV -->
				    <div class='kpi-card CV'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>CV</div>
				            <div class='kpi-icon'>🎛</div>
				        </div>
				        <div class='kpi-value'>"&_CV_Format&"</div>
				    </div>
				
				    <!-- EAC -->
				    <div class='kpi-card EAC'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>EAC</div>
				            <div class='kpi-icon'>🎯</div>
				        </div>
				        <div class='kpi-value'>"&_EAC_Format&"</div>
				    </div>
				
				    <!-- VAC -->
				    <div class='kpi-card VAC'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>VAC</div>
				            <div class='kpi-icon'>📊</div>
				        </div>
				        <div class='kpi-value'>"&_VAC_Format&"</div>
				    </div>
				
				    <!-- CPI -->
				    <div class='kpi-card CPI'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>CPI</div>
				            <div class='kpi-icon'>🚦</div>
				        </div>
				        <div class='kpi-value'>"&_CPI_Format&"</div>
				    </div>
				
				    <!-- SPI -->
				    <div class='kpi-card SPI'>
				        <div class='kpi-header'>
				            <div class='kpi-title'>SPI</div>
				            <div class='kpi-icon'>📆</div>
				        </div>
				        <div class='kpi-value'>"&_SPI_Format&"</div>
				    </div>
				
				</div>
				</body>
				</html>
				"
				```
			displayFolder: Visuals
			lineageTag: 4ef5b433-a3a3-4232-912f-2ff11402875c

		measure CounTaskPlanned =
				
				    VAR _datef = EOMONTH(TODAY(),0)
					VAR _maxdate = EOMONTH(
						MAX(DimCalendar[Date]),
						0
					)
					VAR _mindate = EOMONTH(
						MAX(DimCalendar[Date]),
						-1
					) + 1
					VAR _Count =COUNTROWS(
					SUMMARIZECOLUMNS(
						DimTask[task_id],
						DimTask[planned_enddate],
						DimTask[Real_EndDate],
						FILTER(
							ALL(DimTask[planned_enddate]),
							DimTask[planned_enddate] >= _mindate && DimTask[planned_enddate] <= _maxdate
						),
						"Progress", [#Progress(%)]
					))
					RETURN
						IF(_maxdate <= _datef,_Count,BLANK())
			formatString: 0
			displayFolder: Calculations
			lineageTag: 2a18c755-3071-4bbc-9b6c-e70934b7405d

		measure CounTaskReal =
				
				    VAR _datef = EOMONTH(TODAY(),0)
					VAR _maxdate = EOMONTH(
						MAX(DimCalendar[Date]),
						0
					)
					VAR _mindate = EOMONTH(
						MAX(DimCalendar[Date]),
						-1
					) + 1
					VAR _Count =COUNTROWS(
					SUMMARIZECOLUMNS(
						DimTask[task_id],
						DimTask[planned_enddate],
						DimTask[Real_EndDate],
						FILTER(
							ALL(DimTask[Real_EndDate]),
							DimTask[Real_EndDate] >= _mindate && DimTask[Real_EndDate] <= _maxdate
						),
						"Progress", [#Progress(%)]
					))
					RETURN
						IF(_maxdate <= _datef,_Count,BLANK())
			formatString: 0
			displayFolder: Calculations
			lineageTag: 398db4b0-1cd3-40d8-9c41-dc25930a28d7

		measure CountDone =
				COUNTROWS(FILTER(
				    ADDCOLUMNS(
				        SUMMARIZE(
				            Fact_Task,
				            DimTask[task_id]
				        ),
				        "Status1", [Status]
				    ),[Status1]="Done")
				)
			formatString: 0
			displayFolder: Basics
			lineageTag: 007b64b9-805a-43bd-a836-7514e453a561

		measure CountInProgress =
				COUNTROWS(FILTER(
				    ADDCOLUMNS(
				        SUMMARIZE(
				            Fact_Task,
				            DimTask[task_id]
				        ),
				        "Status1", [Status]
				    ),[Status1]="In Progress")
				)
			formatString: 0
			displayFolder: Basics
			lineageTag: c5d4a0a3-a325-4fbb-940e-4a9a90536f9c

		measure CountToDo =
				COUNTROWS(FILTER(
				    ADDCOLUMNS(
				        SUMMARIZE(
				            Fact_Task,
				            DimTask[task_id]
				        ),
				        "Status1", [Status]
				    ),[Status1]="To Do")
				)
			formatString: 0
			displayFolder: Basics
			lineageTag: a4179ed6-8e18-4945-b9d1-ba2a57a3a262

		measure CV(%) = DIVIDE([#CV],[#EV],0)
			formatString: 0.00\ %;-0.00\ %;0.00\ %
			displayFolder: Calculations
			lineageTag: 2af02c10-bfd7-44a7-8127-a0335994e05a

		measure RealEndDate = IF([#Progress(%)] = 1,MAX(Fact_Task[real_enddate]),BLANK())
			formatString: dd/mm/yyyy
			displayFolder: Dates
			lineageTag: bde5cbd7-f5bc-4a31-a153-8852b14d3f5c

			annotation PBI_FormatHint = {"isDateTimeCustom":true}

		measure RealStartDate = MIN(Fact_Task[real_startdate])
			formatString: dd/mm/yyyy
			displayFolder: Dates
			lineageTag: 16011e4a-cf0d-4786-8f6a-dc483a6c611d

			annotation PBI_FormatHint = {"isDateTimeCustom":true}

		measure Status =
				
				VAR _Progress = [#Progress(%)]
				VAR _RealStart = MIN(Fact_Task[real_startdate])
				VAR _RealEnd = SWITCH(TRUE(),
				                _Progress = 1,FORMAT(MAX(Fact_Task[real_enddate]),"DD/MM/YYYY"),
				                _Progress < 1 = BLANK(),
				                BLANK())
				VAR _Result = SWITCH(TRUE(),
				                ISBLANK(_RealStart) && ISBLANK(_RealEnd),"To Do",
				                NOT(ISBLANK(_RealStart)) && ISBLANK(_RealEnd),"In Progress",
				                "Done")
				RETURN _Result
			displayFolder: Status
			lineageTag: e77aa94f-ec5f-4b4f-a35d-7beb785af79a

		measure Status_Alert =
				
				VAR _SPI = [#SPI]
				VAR _CPI = [#CPI]
				VAR _Result = SWITCH(TRUE(),
				                ISBLANK(_SPI) && ISBLANK(_CPI), "Not Started",
				                (NOT(ISBLANK(_CPI)) && _CPI<0.90) || (NOT(ISBLANK(_SPI)) && _SPI<0.90),"Critical",
				                (NOT(ISBLANK(_CPI)) && _CPI<1) || (NOT(ISBLANK(_SPI)) && _SPI<1),"At Risk",
				                (NOT(ISBLANK(_CPI)) && _CPI>=1) && (NOT(ISBLANK(_SPI)) && _SPI>=1),"Healthy")
				
				RETURN _Result
			displayFolder: Status
			lineageTag: aa2fce58-4f0c-4007-b737-bbc931dd9619

